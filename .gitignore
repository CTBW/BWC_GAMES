# Credentials and local agent state
.env
.env.*
!.env.example
**/auth.json
**/credentials.json
**/token.json
**/tokens.json
.claude/settings.local.json
.codex/auth.json
.mrmak/

# Dependencies and builds
node_modules/
dist/
.cache/
.venv/
.venv*/
venv/
__pycache__/
*.pyc
*.tsbuildinfo
src-tauri/target/
src-tauri/gen/
public/workspace
*.log

# Local inputs and jobs
inbox/*
!inbox/.gitkeep
**/job.json
**/jobs.json
**/result.json
**/upload.json
**/receipts/
**/*.blend1

# Local-only material: licensed sounds, raw downloads, third-party references
# and review captures stay off the public remote ("Where things live" in AGENTS.md)
/local/*
!/local/README.md
projects/meridius/Animations/
**/animation-sources/
projects/meridius/references/style/*.png
projects/meridius/review/**/*.png
projects/meridius/review/**/*.jpg
projects/meridius/review/**/*.jpeg
projects/meridius/review/**/*.webp
projects/meridius/review/**/*.gif
projects/meridius/review/**/*.mp4
# Approved paid generations go public as WebP copies; the full-size PNG
# originals they were made from stay local.
projects/meridius/references/characters/goblin_*/*.png
!projects/meridius/references/characters/goblin_archer/source_crop.png
!projects/meridius/references/characters/goblin_spear/source_crop.png
!projects/meridius/references/characters/goblin_rabble/ref_rabble_faces.png

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
