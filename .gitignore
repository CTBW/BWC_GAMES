# Credentials and local agent state
.env
.env.*
!.env.example
**/auth.json
**/credentials.json
**/token.json
**/tokens.json
.claude/settings.local.json
.codex/auth.json
.mrmak/

# Dependencies and builds
node_modules/
dist/
.cache/
.venv/
.venv*/
venv/
__pycache__/
*.pyc
*.tsbuildinfo
src-tauri/target/
src-tauri/gen/
public/workspace
*.log

# Local inputs and jobs
inbox/*
!inbox/.gitkeep
**/job.json
**/jobs.json
**/result.json
**/upload.json
**/receipts/
**/*.blend1

# Local-only material: licensed sounds, raw downloads, third-party references
# and review captures stay off the public remote ("Where things live" in AGENTS.md)
/local/*
!/local/README.md
projects/meridius/Animations/
**/animation-sources/
projects/meridius/references/style/*.png
projects/meridius/review/**/*.png
projects/meridius/review/**/*.jpg
projects/meridius/review/**/*.jpeg
projects/meridius/review/**/*.webp
projects/meridius/review/**/*.gif
projects/meridius/review/**/*.mp4
# Approved paid generations go public as WebP copies; the full-size PNG
# originals they were made from stay local.
projects/meridius/references/characters/goblin_*/*.png
!projects/meridius/references/characters/goblin_archer/source_crop.png
!projects/meridius/references/characters/goblin_spear/source_crop.png
!projects/meridius/references/characters/goblin_rabble/ref_rabble_faces.png
# Terrain and boss art is public as WebP copies in its Workspace card; the
# reference library's full-size PNGs stay local.
projects/meridius/references/backgrounds/terrain/**/*.png
projects/meridius/references/style/terrain/**/*.png
projects/meridius/references/characters/bosses/concepts/**/*.png
# Owner-supplied style guides and boss references, and a Higgsfield site screenshot.
workspace/2026-10-20_meridius/terrain/references/*.png
workspace/2026-10-20_meridius/terrain/northern-night-higgsfield.png
workspace/2026-10-20_meridius/bosses/references/*.png
# Sovereign Kiss Higgsfield icons and their concept pack are not approved for publishing.
workspace/2026-10-20_meridius/sovereign-kiss/sovereign-kiss-icon-fog-b.png
workspace/2026-10-20_meridius/sovereign-kiss/sovereign-kiss-icon-warcraft-a.png
workspace/2026-10-20_meridius/sovereign-kiss/sovereign-kiss-icon-higgsfield-v1.png
workspace/2026-10-20_meridius/sovereign-kiss/sovereign-kiss-fog-concept-pack.zip
# Mixamo-derived animation exports are not redistributable.
workspace/2026-10-20_meridius/motion-study/mixamo/*.glb
# Tripo downloads in the owner's Chrome save folder; tripo/<unit>/ holds the copies.
projects/meridius/references/characters/FBX/

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
